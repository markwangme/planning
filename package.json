{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore \"./data/**\" --ignore \"./dist/**\" server.ts",
    "dev:once": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','server.js']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "cf:build": "vite build",
    "cf:dev": "npm run cf:build && wrangler pages dev dist --compatibility-flag=nodejs_compat",
    "cf:deploy": "npm run cf:build && wrangler pages deploy dist --project-name planning",
    "cf:d1:create": "wrangler d1 create planning-db",
    "cf:d1:migrate:local": "wrangler d1 migrations apply planning-db --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply planning-db --remote"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.135.0"
  }
}
